# Copy to .env and fill in. Never commit .env.

# Group ids the server is allowed to serve, comma separated.
# 5028 = МБС-301-О-01. Find others with: uv run python -m app.cli find-group "МБС-401"
GROUPS=5028

# Client tokens, comma separated — one per person, so they can be rotated independently.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=change-me-first-token,change-me-second-token

# Token for POST /api/v1/admin/refresh. Leave empty to disable the endpoint.
ADMIN_TOKEN=

# How often the background job pulls the university API.
FETCH_INTERVAL_HOURS=3

# Upper bound for the ?days= query parameter.
DAYS_AHEAD_MAX=21

# How many past days the snapshot keeps (only the .ics feed exposes them).
ICS_PAST_DAYS=14

# Data older than this is reported as stale:true. Empty = FETCH_INTERVAL_HOURS * 2.
STALE_AFTER_HOURS=

TZ=Asia/Omsk
DATA_DIR=data
LOG_LEVEL=INFO

# Requests per minute per token.
RATE_LIMIT_PER_MINUTE=60
