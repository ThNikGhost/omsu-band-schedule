<template>
  <div class="page" @click="nextView">

    <div class="header">
      <text class="clock">{{ clock }}</text>
      <text class="view-title">{{ viewTitle }}</text>
      <text class="stale-mark" if="{{ stale }}">пора обновить расписание</text>
      <text class="stale-mark" if="{{ approx }}">примерно, по шаблону</text>
      <text class="fault" if="{{ fault }}">{{ fault }}</text>
    </div>

    <!-- Расписания нет вовсе: такое возможно только при битой сборке -->
    <div class="body" if="{{ !hasData }}">
      <text class="headline">Нет расписания</text>
      <text class="detail">Соберите приложение заново</text>
    </div>

    <!-- Сейчас -->
    <div class="body" if="{{ hasData && view === 0 }}">
      <text class="headline">{{ now.headline }}</text>
      <text class="detail" if="{{ now.detail }}">{{ now.detail }}</text>

      <div class="card" if="{{ now.card }}">
        <text class="card-label">{{ now.card.label }}</text>
        <text class="card-name">{{ now.card.name }}</text>
        <text class="card-meta">{{ now.card.time }}</text>
        <text class="card-meta">{{ now.card.where }}</text>
        <text class="card-meta">{{ now.card.teacher }}</text>
      </div>
    </div>

    <!-- Сегодня / Далее: одна и та же вёрстка -->
    <div class="body" if="{{ hasData && (view === 1 || view === 2) }}">
      <text class="day-subtitle" if="{{ showSubtitle }}">{{ day.subtitle }}</text>
      <text class="empty" if="{{ day.empty }}">{{ day.emptyText }}</text>
      <scroll class="scroll" scroll-y="true" if="{{ !day.empty }}">
        <div
          class="row"
          for="{{(rowIndex, row) in day.rows}}"
          tid="key"
          style="{{ row.style }}">
          <text class="row-top">{{ row.top }}</text>
          <text class="row-name">{{ row.name }}</text>
          <text class="row-bottom">{{ row.bottom }}</text>
        </div>
        <div class="tail"></div>
      </scroll>
    </div>

    <!-- Звонки -->
    <div class="body" if="{{ hasData && view === 3 }}">
      <scroll class="scroll-full" scroll-y="true">
        <div
          class="bell-row"
          for="{{(bellIndex, bell) in bells.rows}}"
          tid="key"
          style="{{ bell.style }}">
          <text class="bell-pair">{{ bell.label }}</text>
          <div class="bell-main">
            <text class="bell-time">{{ bell.time }}</text>
            <text class="bell-half" if="{{ bell.h1 }}">{{ bell.h1 }}</text>
            <text class="bell-half" if="{{ bell.h2 }}">{{ bell.h2 }}</text>
          </div>
        </div>
        <div class="tail"></div>
      </scroll>
    </div>

    <!-- Состояние -->
    <div class="body status-body" if="{{ view === 4 }}">
      <scroll class="scroll-full" scroll-y="true">
      <text class="status-line">Группа</text>
      <text class="status-value">{{ status.group }}</text>
      <text class="status-line">Расписание собрано</text>
      <text class="status-value">{{ status.built }}</text>
      <text class="status-line">Данных</text>
      <text class="status-value">{{ status.volume }}</text>
      <text class="status-line">Из них по шаблону</text>
      <text class="status-value">{{ status.guessed }}</text>
      <text class="status-note">{{ status.note }}</text>
      <div class="tail"></div>
      </scroll>
    </div>

    <div class="footer">
      <text class="dots">{{ dots }}</text>
    </div>
  </div>
</template>

<script>
/*
 * Одна страница, пять разделов, тап листает их по кругу.
 *
 * Приложение полностью автономно: расписание лежит в самой сборке, и браслет
 * никуда не обращается — ни в сеть, ни к телефону, ни в хранилище. Так решено
 * потому, что bluetooth-сессия у браслета одна, и держит её Mi Fitness ради
 * сна и пульса; выбирать между расписанием и здоровьем не пришлось
 * (см. docs/DECISIONS.md).
 *
 * Отсюда же и обязанность приложения: раз ничто не обновит его само, оно
 * должно честно сказать, когда данные состарились. Этим занимается `stale`.
 *
 * Правила платформы, которым подчиняется этот файл, — в docs/VELA-RULES.md.
 * Коротко, самое важное:
 *   - в `private` только то, что рисуется; таймеры живут вне модели;
 *   - `onInit` ничего не делает, вся инициализация — в `onReady`;
 *   - строки рисуются обычными div с for: <list>/<list-item> на устройстве
 *     занимает место, но не рисует ни одного элемента.
 */

import bakedSchedule from '../../common/baked.js'
import bellsData from '../../common/bells.js'
import { orDash, hhmm, plural, timestampLabel } from '../../common/format.js'
import { countLessons } from '../../common/schedule.js'
import { bellsView, nextDayView, nowView, todayView } from '../../common/viewmodel.js'
import { isApproximate, offlinePayload } from '../../common/offline.js'

const VIEW_TITLES = ['Сейчас', 'Сегодня', 'Далее', 'Звонки', 'Состояние']
const VIEW_COUNT = VIEW_TITLES.length

// Пока экран открыт, пересчитываем состояние раз в минуту: этого хватает,
// чтобы «до перемены 12 мин» не врало, и не будит процессор попусту. Первый
// тик выравнивается по границе минуты, чтобы часы не отставали на полминуты.
const TICK_MS = 60000

// Через сколько дней после сборки начать предупреждать. Вуз публикует вперёд
// дней на десять, а двухнедельный шаблон покрывает остальное — но дальше
// трёх недель ручаться уже не за что.
const STALE_AFTER_DAYS = 21

/**
 * Нереактивное состояние страницы: таймеры и распакованное расписание.
 * Класть их в `private` значит просить фреймворк сделать реактивным то,
 * что рисовать не нужно.
 */
let runtimeState = null

function getState() {
  if (!runtimeState) {
    runtimeState = { payload: null, guessedDays: 0, alignTimer: null, tickTimer: null }
  }
  return runtimeState
}

export default {
  private: {
    view: 0,
    viewTitle: VIEW_TITLES[0],
    dots: '',
    clock: '--:--',
    stale: false,
    approx: false,
    hasData: false,
    showSubtitle: false,
    fault: '',
    now: { headline: '', detail: '', card: null },
    day: { subtitle: '', rows: [], empty: true, emptyText: '' },
    bells: { rows: [] },
    status: { group: '—', built: '—', volume: '—', guessed: '—', note: '' }
  },

  // Здесь намеренно пусто: шаблон ещё не скомпилирован, а работа в этом хуке —
  // одна из причин, по которой первая версия приложения не запускалась.
  onInit() {},

  onReady() {
    this.guard('onReady', function (self) {
      self.load()
      self.refresh()
    })
  },

  onShow() {
    this.guard('onShow', function (self) {
      // Расписание строится от «сегодня», а день мог смениться, пока
      // приложение было закрыто.
      self.load()
      self.refresh()
      self.startTimer()
    })
  },

  onHide() {
    this.guard('onHide', function (self) {
      self.stopTimer()
    })
  },

  onDestroy() {
    this.guard('onDestroy', function (self) {
      self.stopTimer()
      runtimeState = null
    })
  },

  /**
   * Показывает исключение на экране вместо того, чтобы уронить страницу.
   *
   * Снять `console.log` с браслета нечем, поэтому единственный способ узнать об
   * ошибке — вывести её сюда. Молчаливое падение уже стоило нам вечера: первая
   * версия приложения умирала на загрузке модулей и показывала чёрный экран,
   * ничем себя не объясняя.
   */
  guard(label, body) {
    try {
      body(this)
    } catch (err) {
      const text = err && err.message ? err.message : String(err)
      console.warn(label + ' упал: ' + text)
      try {
        this.fault = label + ': ' + text
      } catch (ignored) {
        // Если даже это не проходит, помочь уже нечем.
      }
    }
  },

  load() {
    const state = getState()
    state.payload = offlinePayload(bakedSchedule, deviceMoment().iso)
    state.guessedDays = 0
    if (state.payload) {
      for (let i = 0; i < state.payload.days.length; i += 1) {
        if (state.payload.days[i].a) {
          state.guessedDays += 1
        }
      }
    }
  },

  // ------------------------------------------------------------ таймер

  startTimer() {
    this.stopTimer()
    const self = this
    const state = getState()
    // Выравнивание по границе минуты: иначе часы на экране отстают от системных
    // в среднем на полтика.
    state.alignTimer = setTimeout(function () {
      state.alignTimer = null
      if (!self.$valid) {
        return
      }
      self.refresh()
      state.tickTimer = setInterval(function () {
        if (!self.$valid) {
          return
        }
        self.refresh()
      }, TICK_MS)
    }, TICK_MS - (Date.now() % TICK_MS))
  },

  stopTimer() {
    const state = getState()
    if (state.alignTimer) {
      clearTimeout(state.alignTimer)
      state.alignTimer = null
    }
    if (state.tickTimer) {
      clearInterval(state.tickTimer)
      state.tickTimer = null
    }
  },

  // -------------------------------------------------------------- вид

  nextView() {
    this.guard('переключение', function (self) {
      self.view = (self.view + 1) % VIEW_COUNT
      self.refresh()
    })
  },

  refresh() {
    const state = getState()
    const moment = deviceMoment()
    const payload = state.payload

    this.showSubtitle = this.view === 1
    this.approx = false
    this.hasData = !!payload
    this.clock = hhmm(moment.minutes)
    this.viewTitle = VIEW_TITLES[this.view]
    this.dots = dotsFor(this.view)
    this.stale = isOutdated(payload, moment.iso)

    if (this.view === 0) {
      this.now = decorateNow(nowView(payload, bellsData, moment.iso, moment.minutes))
    } else if (this.view === 1) {
      this.day = decorateDay(todayView(payload, bellsData, moment.iso, moment.minutes))
      this.approx = isApproximate(payload, this.day.date)
    } else if (this.view === 2) {
      this.day = decorateDay(nextDayView(payload, bellsData, moment.iso))
      // «Далее» ничего не добавляет к «Завтра» — день сам себе заголовок.
      this.viewTitle = this.day.subtitle || VIEW_TITLES[2]
      this.approx = isApproximate(payload, this.day.date)
    } else if (this.view === 3) {
      this.bells = decorateBells(bellsView(bellsData, moment.minutes, todayLessons(payload, moment.iso)))
    } else {
      this.status = buildStatus(payload, state.guessedDays, this.stale)
    }
  }
}

/** Локальное время устройства. Браслет живёт в той же зоне, что и вуз. */
function deviceMoment() {
  const date = new Date()
  return {
    ms: date.getTime(),
    minutes: date.getHours() * 60 + date.getMinutes(),
    iso: isoDate(date)
  }
}

function isoDate(date) {
  const month = date.getMonth() + 1
  const day = date.getDate()
  return date.getFullYear() + '-' + two(month) + '-' + two(day)
}

function two(value) {
  return value < 10 ? '0' + value : String(value)
}

/**
 * Пора ли пересобирать приложение.
 *
 * Обновить себя оно не может, поэтому обязано предупредить: иначе человек будет
 * смотреть на расписание прошлого месяца и не догадываться об этом.
 */
function isOutdated(payload, todayIso) {
  if (!payload || !payload.gen) {
    return false
  }
  const built = Date.parse(String(payload.gen).slice(0, 10) + 'T00:00:00Z')
  const today = Date.parse(todayIso + 'T00:00:00Z')
  if (isNaN(built) || isNaN(today)) {
    return false
  }
  return today - built > STALE_AFTER_DAYS * 86400000
}

function dotsFor(view) {
  let out = ''
  for (let i = 0; i < VIEW_COUNT; i += 1) {
    out += i === view ? '●' : '·'
  }
  return out
}

function todayLessons(payload, iso) {
  const view = todayView(payload, bellsData, iso, null)
  const lessons = []
  for (let i = 0; i < view.rows.length; i += 1) {
    lessons.push({ p: view.rows[i].pair })
  }
  return lessons
}

/** Аудитория и тип занятия в одну строку, чтобы не плодить пустые строки. */
function whereLine(room, type) {
  const parts = []
  if (room && room !== '—') {
    parts.push(room)
  }
  if (type) {
    parts.push(type)
  }
  return parts.length ? parts.join(' · ') : '—'
}

function decorateNow(view) {
  if (view.card) {
    view.card.where = whereLine(view.card.room, view.card.type)
    view.card.teacher = orDash(view.card.teacher)
  }
  return view
}

// Прошедшие пары раньше гасились прозрачностью, и это было ошибкой: вечером
// прошедшими становятся все, и весь экран выглядел выцветшим. Текст теперь
// всегда полностью белый, а состояние строки различается фоном.
const STYLE_CURRENT = 'background-color: #1E3A5F;'
const STYLE_PAST = 'background-color: #0C0C0C;'
const STYLE_NORMAL = 'background-color: #1A1A1A;'

function decorateDay(view) {
  for (let i = 0; i < view.rows.length; i += 1) {
    const row = view.rows[i]
    // Три строки, а не одна: всё вместе давало 24 знака при вмещающихся 17,
    // и тип занятия обрезался в «П...».
    row.top = row.pair + ' пара · ' + row.start
    row.bottom = whereLine(row.room, row.type)
    row.style = row.current ? STYLE_CURRENT : row.past ? STYLE_PAST : STYLE_NORMAL
  }
  if (!view.emptyText) {
    view.emptyText = 'Пар нет'
  }
  return view
}

function decorateBells(view) {
  for (let i = 0; i < view.rows.length; i += 1) {
    const row = view.rows[i]
    // Половины пары — каждая своей строкой. Одной строкой они не помещаются
    // в 142 px, а перенос на устройстве посимвольный и рвёт время пополам.
    row.h1 = row.halves.length > 0 ? row.halves[0] : ''
    row.h2 = row.halves.length > 1 ? row.halves[1] : ''
    // Большой перерыв идёт без номера — вместо цифры ставим точку.
    row.label = row.kind === 'break' ? '·' : String(row.pair)
    row.style = row.current ? STYLE_CURRENT : row.scheduled ? STYLE_NORMAL : STYLE_PAST
  }
  return view
}

function lessonCount(payload) {
  const n = countLessons(payload)
  return n + ' ' + plural(n, 'пара', 'пары', 'пар')
}

function buildStatus(payload, guessedDays, stale) {
  if (!payload) {
    return {
      group: '—',
      built: '—',
      volume: '—',
      guessed: '—',
      note: 'Соберите приложение заново'
    }
  }

  const days = payload.days ? payload.days.length : 0
  return {
    group: orDash(payload.g),
    built: timestampLabel(payload.gen),
    volume: days + ' дн. · ' + lessonCount(payload),
    guessed: guessedDays + ' ' + plural(guessedDays, 'день', 'дня', 'дней'),
    note: stale
      ? 'Расписание давно не пересобирали — проверьте на сайте'
      : 'Тап по экрану — следующий раздел'
  }
}
</script>

<style>
/* Размеры заданы в пикселях, а не в процентах.
   На устройстве `height: 100%` не разрешается — проценту не от чего считаться,
   и страница схлопывается до высоты содержимого: видно шапку, а ниже фон окна.
   Вместе с ней схлопывается `.body` с `flex-grow`, и список пропадает.
   212×520 — экран Band 10, а designWidth равен 212, поэтому px здесь 1:1.
   Так же поступает рабочее приложение honghongaiHub (336×480 под свой экран). */
.page {
  flex-direction: column;
  width: 212px;
  height: 520px;
  background-color: #000000;
  padding-top: 14px;
  padding-bottom: 10px;
  padding-left: 12px;
  padding-right: 12px;
}

.header {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.clock {
  font-size: 42px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  line-height: 46px;
}

.view-title {
  font-size: 17px;
  font-weight: bold;
  color: #c0c0c0;
  text-align: center;
  margin-top: 2px;
  line-height: 20px;
}

.stale-mark {
  font-size: 14px;
  font-weight: bold;
  color: #e0a050;
  text-align: center;
  margin-top: 2px;
}

/* Исключение видно прямо на браслете: логов с устройства не снять ничем. */
.fault {
  font-size: 14px;
  font-weight: bold;
  color: #ff8080;
  text-align: center;
  margin-top: 2px;
  lines: 3;
}

.body {
  flex-direction: column;
  width: 100%;
  flex-grow: 1;
  margin-top: 10px;
}

/* --- Сейчас --- */

.headline {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 3;
}

.detail {
  font-size: 19px;
  font-weight: bold;
  color: #d0d0d0;
  text-align: center;
  margin-top: 4px;
  lines: 2;
}

.card {
  flex-direction: column;
  width: 100%;
  margin-top: 14px;
  padding-top: 10px;
  padding-bottom: 10px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 14px;
  background-color: #141414;
}

.card-label {
  font-size: 15px;
  font-weight: bold;
  color: #b0b0b0;
}

.card-name {
  font-size: 23px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 2px;
  lines: 3;
}

.card-meta {
  font-size: 18px;
  font-weight: bold;
  color: #d0d0d0;
  margin-top: 2px;
  lines: 1;
  text-overflow: ellipsis;
}

/* --- Сегодня / Далее --- */

.day-subtitle {
  font-size: 18px;
  font-weight: bold;
  color: #c0c0c0;
  text-align: center;
  margin-bottom: 6px;
  line-height: 22px;
}

.empty {
  font-size: 22px;
  font-weight: bold;
  color: #c0c0c0;
  text-align: center;
  margin-top: 40px;
}

/* Список прокручивается: у дня бывает до восьми пар, а с двумя подгруппами
   строк ещё больше, и в 520 px они не помещаются.

   Высота ЗАДАНА ЯВНО и это обязательно: документация Vela требует
   «使用时需要显式地设置高度», а одного flex-grow недостаточно — без опорных
   размеров дерево схлопывается, и экран остаётся пустым. 370 px посчитаны как
   520 минус шапка, подзаголовок и точки внизу; уточнить на устройстве. */
/* Обычный div, а не <list>: на Band 10 <list>/<list-item> занимает место,
   но не рисует ни одной строки. Прокрутка — на <scroll scroll-y="true">, и
   высота здесь обязана быть фиксированной: 「竖向滚动需要设置定高」. */
.scroll {
  flex-direction: column;
  width: 100%;
  height: 374px;
}

/* Экраны без подзаголовка: «Звонки», «Состояние», «Отладка». */
.scroll-full {
  flex-direction: column;
  width: 100%;
  height: 402px;
}

.row {
  flex-direction: column;
  width: 100%;
  margin-bottom: 6px;
  padding-top: 6px;
  padding-bottom: 6px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 10px;
}





.row-top {
  font-size: 17px;
  font-weight: bold;
  color: #c8c8c8;
  lines: 1;
  text-overflow: ellipsis;
}

.row-name {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 2px;
  margin-bottom: 2px;
  lines: 2;
  text-overflow: ellipsis;
}

.row-bottom {
  font-size: 17px;
  font-weight: bold;
  color: #c8c8c8;
  lines: 1;
  text-overflow: ellipsis;
}



/* --- Звонки --- */

.bell-row {
  flex-direction: row;
  width: 100%;
  margin-bottom: 6px;
  padding-top: 6px;
  padding-bottom: 6px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 10px;
}

.bell-pair {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  width: 18px;
  text-align: center;
  margin-right: 8px;
}

.bell-main {
  flex-direction: column;
  flex-grow: 1;
}

.bell-time {
  font-size: 19px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

/* Половина пары: 13 знаков кеглем 14 — это 91 px при доступных 142, помещается
   с запасом. Одной строкой обе половины не влезали и рвались посимвольно. */
.bell-half {
  font-size: 15px;
  font-weight: bold;
  color: #bcbcbc;
  lines: 1;
}

/* Запас под последней строкой: без него прокрутка упирается ровно в край
   содержимого и последняя строка читается впритык. */
.tail {
  width: 100%;
  height: 28px;
}

