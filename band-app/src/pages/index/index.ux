<template>
  <div class="page" @click="nextView" @longpress="requestSync">

    <div class="header">
      <text class="clock">{{ clock }}</text>
      <text class="view-title">{{ viewTitle }}</text>
      <text class="stale-mark" if="{{ stale }}">данные устарели</text>
      <text class="fault" if="{{ fault }}">{{ fault }}</text>
    </div>

    <!-- Нет данных вообще -->
    <div class="body" if="{{ !hasData }}">
      <text class="headline">Нет расписания</text>
      <text class="detail">Откройте AstroBox на телефоне</text>
      <div class="refresh" @click="requestSync">
        <text class="refresh-text">{{ status.action }}</text>
      </div>
      <text class="detail">{{ status.link }}</text>
    </div>

    <!-- Сейчас -->
    <div class="body" if="{{ hasData && view === 0 }}">
      <text class="headline">{{ now.headline }}</text>
      <text class="detail" if="{{ now.detail }}">{{ now.detail }}</text>

      <div class="card" if="{{ now.card }}">
        <text class="card-label">{{ now.card.label }}</text>
        <text class="card-name">{{ now.card.name }}</text>
        <text class="card-meta">{{ now.card.time }}</text>
        <text class="card-meta">{{ now.card.where }}</text>
        <text class="card-meta">{{ now.card.teacher }}</text>
      </div>
    </div>

    <!-- Сегодня / Далее: одна и та же вёрстка -->
    <div class="body" if="{{ hasData && (view === 1 || view === 2) }}">
      <text class="day-subtitle">{{ day.subtitle }}</text>
      <text class="empty" if="{{ day.empty }}">{{ day.emptyText }}</text>
      <div class="scroll" if="{{ !day.empty }}">
        <div
          class="row"
          for="{{(rowIndex, row) in day.rows}}"
          tid="key"
          style="{{ row.style }}">
          <div class="row-left">
            <text class="row-pair">{{ row.pair }}</text>
            <text class="row-start">{{ row.start }}</text>
          </div>
          <div class="row-main">
            <text class="row-name">{{ row.name }}</text>
            <text class="row-meta">{{ row.where }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Звонки -->
    <div class="body" if="{{ hasData && view === 3 }}">
      <div class="scroll">
        <div
          class="bell-row"
          for="{{(bellIndex, bell) in bells.rows}}"
          tid="key"
          style="{{ bell.style }}">
          <text class="bell-pair">{{ bell.label }}</text>
          <div class="bell-main">
            <text class="bell-time">{{ bell.time }}</text>
            <text class="bell-halves" if="{{ bell.halvesText }}">{{ bell.halvesText }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Состояние -->
    <div class="body status-body" if="{{ hasData && view === 4 }}">
      <text class="status-line">Группа</text>
      <text class="status-value">{{ status.group }}</text>
      <text class="status-line">Обновлено</text>
      <text class="status-value">{{ status.updated }}</text>
      <text class="status-line">Данных</text>
      <text class="status-value">{{ status.volume }}</text>
      <text class="status-line">Связь</text>
      <text class="status-value">{{ status.link }}</text>
      <div class="refresh" @click="requestSync">
        <text class="refresh-text">{{ status.action }}</text>
      </div>
      <text class="status-note">{{ status.note }}</text>
    </div>

    <!-- Отладка: единственный способ увидеть, что происходит на устройстве -->
    <div class="body status-body" if="{{ view === 5 }}">
      <text class="status-line">Сборка</text>
      <text class="status-value">{{ diag.build }}</text>
      <text class="status-line">Связь</text>
      <text class="status-value">{{ diag.link }}</text>
      <text class="status-line">Кадры</text>
      <text class="status-value">{{ diag.frames }}</text>
      <text class="status-line">Крупнейший кадр</text>
      <text class="status-value">{{ diag.biggest }}</text>
      <text class="status-line">Кэш</text>
      <text class="status-value">{{ diag.cache }}</text>
      <text class="status-line">Последняя ошибка</text>
      <text class="status-value">{{ diag.error }}</text>
    </div>

    <div class="footer">
      <text class="dots">{{ dots }}</text>
    </div>
  </div>
</template>

<script>
/*
 * Одна страница, шесть разделов, тап листает их по кругу.
 *
 * Долгое нажатие продублировано на всю страницу намеренно: неизвестно, всплывёт
 * ли тап по кнопке «Обновить» до обработчика страницы. Оба исхода нормальны —
 * либо просто синхронизация, либо синхронизация и переход на «Сейчас», — но
 * жест, который точно ни с чем не конфликтует, тоже нужен.
 *
 * Правила платформы, которым подчиняется этот файл, — в docs/VELA-RULES.md.
 * Коротко, самое важное:
 *   - в `private` только то, что рисуется; экземпляр соединения и таймеры
 *     живут вне модели, иначе фреймворк пытается сделать реактивным нативный
 *     объект;
 *   - `onInit` ничего не делает, вся инициализация — в `onReady`;
 *   - строки рисуются обычными div с for: <list>/<list-item> на устройстве
 *     занимает место, но не рисует ни одного элемента.
 */

import bellsData from '../../common/bells.js'
import mockPayload from '../../common/mock.js'
import { orDash, hhmm, plural, timestampLabel } from '../../common/format.js'
import { countLessons, isStale, pruneBefore } from '../../common/schedule.js'
import { bellsView, nextDayView, nowView, todayView } from '../../common/viewmodel.js'
import { createReceiver, hasTimedOut, step, syncRequest, utf8Length } from '../../common/link.js'
import * as cache from '../../device/storage.js'
import * as wire from '../../device/link.js'
import { BUILD, STAGE } from '../../device/stage.js'

const VIEW_TITLES = ['Сейчас', 'Сегодня', 'Далее', 'Звонки', 'Состояние', 'Отладка']
const VIEW_COUNT = VIEW_TITLES.length
const VIEW_DEBUG = 5

// Пока экран открыт, пересчитываем состояние раз в минуту: этого хватает,
// чтобы «до перемены 12 мин» не врало, и не будит процессор попусту. Первый
// тик выравнивается по границе минуты, чтобы часы не отставали на полминуты.
const TICK_MS = 60000

// Пока телефона в схеме нет, показываем вшитый пример: на этапе 2 он служит
// запасным вариантом, когда кэш ещё пуст, и экран не выглядит сломанным.
const DEMO_WITHOUT_PHONE = STAGE < 3

/**
 * Нереактивное состояние страницы.
 *
 * Сюда идёт всё, что нельзя отдать фреймворку: экземпляр соединения, таймеры,
 * распакованный payload, счётчики отладки. Класть нативный объект в `private`
 * означает просить фреймворк сделать его реактивным — рабочее приложение
 * `Portable-Class-Schedule` специально этого избегает, и раздел документации
 * про память советует то же.
 *
 * Оно держит состояние в `WeakMap` по экземпляру страницы; здесь достаточно
 * модульного синглтона, потому что страница ровно одна, а лишняя зависимость
 * от `WeakMap` в рантайме браслета сейчас не нужна — на первом этапе любой
 * отказ должен указывать на вёрстку, а не на неё.
 */
let runtimeState = null

function createRuntimeState() {
  return {
    payload: null,
    connection: null,
    receiver: createReceiver(),
    linkState: wire.LINK.UNKNOWN,
    lastError: null,
    alignTimer: null,
    tickTimer: null,
    rx: 0,
    txOk: 0,
    txFail: 0,
    biggest: 0
  }
}

function getState() {
  if (!runtimeState) {
    runtimeState = createRuntimeState()
  }
  return runtimeState
}

export default {
  private: {
    view: 0,
    viewTitle: VIEW_TITLES[0],
    dots: '',
    clock: '--:--',
    stale: false,
    hasData: false,
    fault: '',
    now: { headline: '', detail: '', card: null },
    day: { subtitle: '', rows: [], empty: true, emptyText: '' },
    bells: { rows: [] },
    status: { group: '—', updated: '—', volume: '—', link: '—', note: '', action: 'Обновить' },
    diag: { build: '', link: '—', frames: '—', biggest: '—', cache: '—', error: '—' }
  },

  // Здесь намеренно пусто: шаблон ещё не скомпилирован, а системные API в этом
  // хуке — одна из причин, по которой первая версия приложения не запускалась.
  onInit() {},

  onReady() {
    this.guard('onReady', function (self) {
      getState()
      self.loadCache()
      self.refresh()
    })
  },

  onShow() {
    this.guard('onShow', function (self) {
      self.openLink()
      self.refresh()
      self.startTimer()
      // Спрашиваем расписание при каждом открытии: если ничего не изменилось,
      // телефон ответит up_to_date и по BLE ничего не поедет.
      self.requestSync()
    })
  },

  onHide() {
    this.guard('onHide', function (self) {
      self.stopTimer()
    })
  },

  onDestroy() {
    this.guard('onDestroy', function (self) {
      self.stopTimer()
      const state = getState()
      wire.close(state.connection)
      state.connection = null
      runtimeState = null
    })
  },

  /**
   * Показывает исключение на экране вместо того, чтобы уронить страницу.
   *
   * Снять `console.log` с браслета нечем, поэтому единственный способ узнать об
   * ошибке — вывести её сюда. Молчаливое падение уже стоило нам вечера: первая
   * версия приложения умирала на загрузке модулей и показывала чёрный экран,
   * ничем себя не объясняя.
   */
  guard(label, body) {
    try {
      body(this)
    } catch (err) {
      const text = err && err.message ? err.message : String(err)
      console.warn(label + ' упал: ' + text)
      try {
        this.fault = label + ': ' + text
      } catch (ignored) {
        // Если даже это не проходит, помочь уже нечем.
      }
    }
  },

  // ------------------------------------------------------------ данные

  loadCache() {
    const self = this
    const state = getState()
    cache.readPayload(function (payload) {
      if (payload) {
        state.payload = payload
      } else if (DEMO_WITHOUT_PHONE) {
        state.payload = mockPayload
      }
      self.refresh()
    })
  },

  storePayload(payload) {
    const self = this
    const state = getState()
    // Вперёд объём ограничен сервером (параметр days), назад — этой чисткой,
    // иначе кэш рос бы весь семестр.
    const trimmed = pruneBefore(payload, deviceMoment().iso)
    cache.writePayload(trimmed, function (ok, problem) {
      if (ok) {
        state.payload = trimmed
        state.lastError = null
        cache.writeMeta({ at: Date.now(), h: trimmed.h })
      } else {
        // Старый кэш остался нетронутым — показываем его дальше.
        state.lastError = problem || 'не удалось сохранить'
      }
      self.refresh()
    })
  },

  // ------------------------------------------------------------- связь

  openLink() {
    const state = getState()
    if (state.connection) {
      this.updateLinkState()
      return
    }
    const self = this
    state.connection = wire.open({
      onOpen() {
        state.linkState = wire.LINK.CONNECTED
        self.refresh()
      },
      onClose() {
        state.linkState = wire.LINK.DISCONNECTED
        self.refresh()
      },
      onError() {
        state.linkState = wire.LINK.DISCONNECTED
        self.refresh()
      },
      onMessage(data) {
        self.onWireMessage(data)
      }
    })
    this.updateLinkState()
  },

  updateLinkState() {
    const self = this
    const state = getState()
    wire.checkState(state.connection, function (linkState) {
      state.linkState = linkState
      self.refresh()
    })
  },

  requestSync() {
    const state = getState()
    if (!state.connection) {
      this.openLink()
    }
    const have = state.payload && state.payload.h ? state.payload.h : null
    const self = this
    this.sendWire(syncRequest(have), function (ok, code) {
      if (!ok) {
        state.lastError = 'телефон недоступен'
        state.linkState = wire.LINK.DISCONNECTED
        console.warn('sync_req не ушёл: ' + code)
        self.refresh()
      }
    })
  },

  /** Единственная точка отправки — чтобы счётчики отладки видели всё. */
  sendWire(text, done) {
    const state = getState()
    wire.send(state.connection, text, function (ok, code) {
      if (ok) {
        state.txOk += 1
      } else {
        state.txFail += 1
      }
      done && done(ok, code)
    })
  },

  onWireMessage(data) {
    const state = getState()
    state.rx += 1

    const size = utf8Length(typeof data === 'string' ? data : JSON.stringify(data) || '')
    if (size > state.biggest) {
      state.biggest = size
    }

    const outcome = step(state.receiver, data, Date.now())
    state.receiver = outcome.state

    if (outcome.log) {
      console.log('link: ' + outcome.log)
    }
    for (let i = 0; i < outcome.send.length; i += 1) {
      this.sendWire(outcome.send[i], null)
    }
    if (outcome.error) {
      state.lastError = outcome.error
    }
    if (outcome.status === 'up_to_date') {
      state.lastError = null
      cache.writeMeta({ at: Date.now(), h: state.payload ? state.payload.h : null })
    }
    if (outcome.apply) {
      this.storePayload(outcome.apply)
      return
    }
    this.refresh()
  },

  // ------------------------------------------------------------ таймер

  startTimer() {
    this.stopTimer()
    const self = this
    const state = getState()
    // Выравнивание по границе минуты: иначе часы на экране отстают от системных
    // в среднем на полтика.
    state.alignTimer = setTimeout(function () {
      state.alignTimer = null
      if (!self.$valid) {
        return
      }
      self.refresh()
      state.tickTimer = setInterval(function () {
        if (!self.$valid) {
          return
        }
        self.refresh()
      }, TICK_MS)
    }, TICK_MS - (Date.now() % TICK_MS))
  },

  stopTimer() {
    const state = getState()
    if (state.alignTimer) {
      clearTimeout(state.alignTimer)
      state.alignTimer = null
    }
    if (state.tickTimer) {
      clearInterval(state.tickTimer)
      state.tickTimer = null
    }
  },

  // -------------------------------------------------------------- вид

  nextView() {
    this.view = (this.view + 1) % VIEW_COUNT
    this.guard('обновление', function (self) {
      self.refresh()
    })
  },

  refresh() {
    const state = getState()
    const moment = deviceMoment()
    const payload = state.payload

    // Оборвавшуюся передачу бросаем и остаёмся на старом кэше.
    if (hasTimedOut(state.receiver, Date.now())) {
      state.receiver = createReceiver()
      state.lastError = 'передача оборвалась'
    }

    this.hasData = !!payload
    this.clock = hhmm(moment.minutes)
    this.viewTitle = VIEW_TITLES[this.view]
    this.dots = dotsFor(this.view)
    this.stale = isStale(payload, moment.ms, 24)

    if (this.view === 0) {
      this.now = decorateNow(nowView(payload, bellsData, moment.iso, moment.minutes))
    } else if (this.view === 1) {
      this.day = decorateDay(todayView(payload, bellsData, moment.iso, moment.minutes))
    } else if (this.view === 2) {
      this.day = decorateDay(nextDayView(payload, bellsData, moment.iso))
    } else if (this.view === 3) {
      this.bells = decorateBells(bellsView(bellsData, moment.minutes, todayLessons(payload, moment.iso)))
    } else if (this.view === VIEW_DEBUG) {
      this.diag = buildDiag(state)
    } else {
      this.status = buildStatus(payload, moment, state.linkState, state.lastError)
    }

    // Экран «нет данных» тоже показывает кнопку и состояние связи.
    if (!payload) {
      this.status = buildStatus(null, moment, state.linkState, state.lastError)
    }
  }
}

/** Локальное время устройства. Браслет живёт в той же зоне, что и вуз. */
function deviceMoment() {
  const date = new Date()
  return {
    ms: date.getTime(),
    minutes: date.getHours() * 60 + date.getMinutes(),
    iso: isoDate(date)
  }
}

function isoDate(date) {
  const month = date.getMonth() + 1
  const day = date.getDate()
  return date.getFullYear() + '-' + two(month) + '-' + two(day)
}

function two(value) {
  return value < 10 ? '0' + value : String(value)
}

function dotsFor(view) {
  let out = ''
  for (let i = 0; i < VIEW_COUNT; i += 1) {
    out += i === view ? '●' : '·'
  }
  return out
}

function todayLessons(payload, iso) {
  const view = todayView(payload, bellsData, iso, null)
  const lessons = []
  for (let i = 0; i < view.rows.length; i += 1) {
    lessons.push({ p: view.rows[i].pair })
  }
  return lessons
}

/** Аудитория и тип занятия в одну строку, чтобы не плодить пустые строки. */
function whereLine(room, type) {
  const parts = []
  if (room && room !== '—') {
    parts.push(room)
  }
  if (type) {
    parts.push(type)
  }
  return parts.length ? parts.join(' · ') : '—'
}

function decorateNow(view) {
  if (view.card) {
    view.card.where = whereLine(view.card.room, view.card.type)
    view.card.teacher = orDash(view.card.teacher)
  }
  return view
}

// Динамический class компилятор поддерживает, но условное оформление здесь
// проще задать инлайновым стилем — значений всего три.
const STYLE_CURRENT = 'opacity: 1;'
const STYLE_PAST = 'opacity: 0.35;'
const STYLE_NORMAL = 'opacity: 0.75;'

function decorateDay(view) {
  for (let i = 0; i < view.rows.length; i += 1) {
    const row = view.rows[i]
    row.where = whereLine(row.room, row.type)
    row.style = row.current ? STYLE_CURRENT : row.past ? STYLE_PAST : STYLE_NORMAL
  }
  if (!view.emptyText) {
    view.emptyText = 'Пар нет'
  }
  return view
}

function decorateBells(view) {
  for (let i = 0; i < view.rows.length; i += 1) {
    const row = view.rows[i]
    row.halvesText = row.halves.join('   ')
    // Большой перерыв идёт без номера — вместо цифры ставим точку.
    row.label = row.kind === 'break' ? '·' : String(row.pair)
    row.style = row.current ? STYLE_CURRENT : row.scheduled ? STYLE_NORMAL : STYLE_PAST
  }
  return view
}

const LINK_TEXT = {
  connected: 'телефон на связи',
  disconnected: 'телефон недоступен',
  unknown: 'связь неизвестна'
}

function lessonCount(payload) {
  const n = countLessons(payload)
  return n + ' ' + plural(n, 'пара', 'пары', 'пар')
}

function buildStatus(payload, moment, linkState, lastError) {
  const link = lastError || LINK_TEXT[linkState] || LINK_TEXT.unknown

  if (!payload) {
    return {
      group: '—',
      updated: '—',
      volume: '—',
      link: link,
      note: 'Тап — следующий раздел, долгое нажатие — обновить',
      action: 'Обновить'
    }
  }

  const days = payload.days ? payload.days.length : 0
  const stale = isStale(payload, moment.ms, 24)
  return {
    group: orDash(payload.g),
    updated: timestampLabel(payload.src),
    volume: days + ' дн. · ' + lessonCount(payload),
    link: lastError || (stale ? 'данные устарели' : link),
    note: 'Тап — следующий раздел, долгое нажатие — обновить',
    action: 'Обновить'
  }
}

/**
 * Экран отладки. Снять `console.log` с браслета нечем — ни AstroBox, ни его CLI
 * этого не умеют, — поэтому состояние показывается прямо на устройстве.
 */
function buildDiag(state) {
  let cacheLine = 'пусто'
  if (state.payload) {
    let bytes = 0
    try {
      bytes = utf8Length(JSON.stringify(state.payload))
    } catch (err) {
      bytes = 0
    }
    cacheLine = (state.payload.days ? state.payload.days.length : 0) + ' дн. · ' + bytes + ' Б'
  }

  return {
    build: BUILD + ' · этап ' + STAGE,
    link: LINK_TEXT[state.linkState] || LINK_TEXT.unknown,
    frames: 'принято ' + state.rx + ' · ушло ' + state.txOk + ' · сбоев ' + state.txFail,
    biggest: state.biggest ? state.biggest + ' Б' : '—',
    cache: cacheLine,
    error: state.lastError || 'нет'
  }
}
</script>

<style>
/* Размеры заданы в пикселях, а не в процентах.
   На устройстве `height: 100%` не разрешается — проценту не от чего считаться,
   и страница схлопывается до высоты содержимого: видно шапку, а ниже фон окна.
   Вместе с ней схлопывается `.body` с `flex-grow`, и список пропадает.
   212×520 — экран Band 10, а designWidth равен 212, поэтому px здесь 1:1.
   Так же поступает рабочее приложение honghongaiHub (336×480 под свой экран). */
.page {
  flex-direction: column;
  width: 212px;
  height: 520px;
  background-color: #000000;
  padding-top: 14px;
  padding-bottom: 10px;
  padding-left: 12px;
  padding-right: 12px;
}

.header {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.clock {
  font-size: 30px;
  color: #ffffff;
  text-align: center;
}

.view-title {
  font-size: 14px;
  color: #7a7a7a;
  text-align: center;
  margin-top: 2px;
}

